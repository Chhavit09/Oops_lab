 
# include <iostream>
# include <string.h>
using namespace std;

int main()
{
 string name;
 int units;
 float bill;
 cout<<"enter the customer name";
 getline(cin,name);
 cout<<"Enter the units consumed";
 cin>>units;
 if(units<=100)
 {
   bill=units*0.60;
 }
 else if(units<=300)
 {
  bill=(100*0.60)+(units-100)*0.80;
 }
 else
 {
  bill=(100*0.60)+(200*0.80)+(units-300)*0.90;
 }
 if(bill<50)
 {
  bill=50;
 }
 if(bill>300)
 {
  bill=bill+bill*0.15;
 }
 cout<<"\n Customer name:"<<name;
 cout<<"\n units consumed:"<<units;
 cout<<"\n Total bill:   Rs"<<bill;
 return 0;
}
